# Seedance 渠道配置（v5.0.3 起 · 三变量必填）
# ============================================================
# ARK_API_KEY         必填 · 渠道 API Key
# SEEDANCE_BASE_URL   渠道 base URL（默认官方火山，可换第三方 Ark 兼容网关）
# SEEDANCE_MODEL      模型 ID（必须带版本后缀，无后缀会 404）

# 渠道一：官方火山引擎 Ark（默认）
#   ARK_API_KEY=<官方火山 key>
#   SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
#   SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128

# 渠道二：第三方 Ark 兼容网关 aigc.learningcat.cn（2026-08-24 起使用）
#   ARK_API_KEY=<第三方 key>
#   SEEDANCE_BASE_URL=https://aigc.learningcat.cn/ark/v3/contents/generations/tasks
#   SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128

# ⚠️ 切换渠道 = 只改这 3 个变量，不碰代码。
# ⚠️ wrapper.sh 会从本 .env 完整加载 ARK_API_KEY + SEEDANCE_BASE_URL + SEEDANCE_MODEL。
#    只填 key 不填 base URL → 回落官方火山 → 若 key 是第三方渠道的会 401。
# ⚠️ 改 .env 后必须重启 Hermes gateway 才生效（MCP server 是常驻进程）。
# ⚠️ verify_api_key 走 GET list 端点，第三方网关可能不支持 → 报 401 是假阴性，
#    判断可用看 generate_video 能否返回 task_id（fast 模型不认 resolution 参数，省略即可）。

ARK_API_KEY=<YOUR_ARK_API_KEY_HERE>
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128

# 图床（uguu.se · 无需 key，匿名上传 · 已废弃 chevereto）
# 上传 endpoint: https://uguu.se/upload.php
# 返回: https://h.uguu.se/<id>.jpg 直链（永久有效，无需鉴权）
